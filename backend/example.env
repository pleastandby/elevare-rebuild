MONGODB_URI="Your MongoDB URI"
GEMINI_API_KEY="Your API Key"
JWT_SECRET="Your JWT Secret"
PORT="Your Port"
NODE_ENV="Your Node Environment"

# Email Configuration (for sending OTPs to users)
# Use a single service email (like noreply@yourdomain.com or yourapp@gmail.com)
# This email will be used to send OTPs TO your users' email addresses
EMAIL_USER="your-service-email@gmail.com"
EMAIL_PASS="your-gmail-app-password"